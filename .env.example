# Required. Keep real values in the deployment platform's secret store.
PROXY_USERNAME=replace-with-primary-username
PROXY_PASSWORD=replace-with-a-long-random-password

# Optional JSON object containing additional accounts.
PROXY_ADDITIONAL_USERS_JSON={"second-user":"replace-with-another-long-random-password"}

# Optional comma-separated initial allowlist. Code defaults are used when omitted.
# PROXY_DOMAINS=openai.com,chatgpt.com,google.com

PROXY_DOMAINS_STATE_PATH=/tmp/selective-proxy/domains.json
PROXY_MAX_CONNECTIONS=64
PROXY_CONNECT_TIMEOUT_SECONDS=10
PROXY_IDLE_TIMEOUT_SECONDS=120
PROXY_TUNNEL_MAX_SECONDS=1800
